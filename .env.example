# DATABASE_URL, REDIS_URL and S3_ENDPOINT_URL point at localhost for tools run
# on the host (pytest, alembic). docker-compose overrides the hosts for containers.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
READINESS_TIMEOUT_SECONDS=2
MAX_UPLOAD_MB=100
# Pages of one document the OCR job reads at the same time.
OCR_CONCURRENCY=4

# --- PostgreSQL ---
POSTGRES_USER=docint
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=docint
DATABASE_URL=postgresql+asyncpg://docint:change-me-postgres@localhost:15432/docint

# --- Redis (Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (SeaweedFS, S3 API). Key pair doubles as the admin credentials. ---
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=docint-s3
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=documents
S3_REGION=us-east-1

# --- LLM (extraction runs only when GOOGLE_API_KEY is set) ---
# Use the paid tier or Vertex for real financial data: free-tier input may be used by the provider.
GOOGLE_API_KEY=
# Provider model IDs change. If extraction fails with "model not found", list the models your
# key can use and set these two.
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Pages of text sent to the model per call.
EXTRACTION_PAGES_PER_CALL=6
# Fields with a confidence below this are flagged for review (0 to 1).
LOW_CONFIDENCE_THRESHOLD=0.5
# Model for search embeddings (768 dimensions are fixed in the code and the database).
EMBEDDING_MODEL=models/gemini-embedding-001

# --- API access ---
# When set, every /api/v1 request needs the header "X-API-Key: <this value>".
# The web server adds it to every call it forwards; it never reaches the browser.
# Leave empty to keep the API open locally. Generate one with: openssl rand -hex 32
API_KEY=

# --- Flower worker dashboard (make flower, see docs/monitoring.md) ---
# Required only to run it. It refuses to start without a user and password.
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-to-a-long-random-value
FLOWER_PORT=5555

# --- Host ports ---
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=15432
REDIS_PORT=6379
S3_PORT=8333